  "weight_decay": 0.0001,
  "feature_weight": 0.2,
  "image_latent_weight": 0.25,
  "image_pixel_weight": 0.5,
  "common_alignment_weight": 0.02,
  "papr_weight": 0.0001,
  "overfit_wer_gate": 0.2,
  "memory_margin_gate": 0.1,
  "clean_validation_wer_gate": 0.6,
  "min_free_gib": 16.0,
